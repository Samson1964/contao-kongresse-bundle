<?php $this->extend('block_unsearchable'); ?>

<?php $this->block('content'); ?>

<?php if ($this->records): ?>
<table class="ce_table">
	<tr>
		<th class="jahr">Jahr</th>
		<th class="typ">Typ</th>
		<th class="ort">Ort</th>
		<th class="datum">Datum</th>
		<th class="info">Bemerkungen</th>
		<th class="buch" title="Buch/Broschüre">B</th>
		<th class="protokoll" title="Protokoll">P</th>
		<th class="links">Links</th>
	</tr>
	<?php $i = 0; ?>
	<?php foreach ($this->records as $item): ?>
		<?php $class = (++$i % 2) ? 'odd' : 'even'; ?>
		<tr class="<?= $class ?> typ_<?= Contao\StringUtil::specialchars($item['typ']) ?><?= $item['online'] ? ' online' : '' ?>">
			<td class="jahr"><?= $item['jahr'] ?></td>
			<td class="typ" title="<?= Contao\StringUtil::specialchars($item['typTitle']) ?>"><?= Contao\StringUtil::specialchars($item['typ']) ?></td>
			<td class="ort"><?= $item['ort'] ?></td>
			<td class="datum"><?= $item['datum'] ?></td>
			<td class="info"><?= Contao\StringUtil::specialchars($item['info']) ?></td>
			<td class="buch"><?= $item['broschuere'] ?></td>
			<td class="protokoll"><?= $item['protokoll'] ?></td>
			<td class="links"><?= $item['links'] ?></td>
		</tr>
	<?php endforeach; ?>
</table>
<?php endif; ?>

<?php $this->endblock(); ?>
